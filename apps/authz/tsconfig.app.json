{
  "extends": "@better-agent/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": ".tsbuild/app",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./app/*"]
    },
    "strictNullChecks": true
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"]
}
