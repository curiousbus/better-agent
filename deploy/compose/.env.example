# ── Domains (must resolve to this server; Caddy gets HTTPS certs for them) ──
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
# Public URL of the API, baked into the web/admin browser bundles at build time.
PUBLIC_API_URL=https://api.example.com

# ── App config (URLs the server trusts / links to) ──
CORS_ORIGIN=https://app.example.com,https://admin.example.com
WEB_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
AUTH_EMAIL_FROM=noreply@example.com
ADMIN_EMAILS=you@example.com

# ── Secrets ──
POSTGRES_PASSWORD=change_me_strong
AUTH_JWT_SECRET=change_me_32+_chars
CREDENTIALS_SECRET=change_me_32+_chars
RESEND_API_KEY=

# ── Attachments: R2 via its S3 API (stays on Cloudflare) ──
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=better-agent-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Invite gate: authz stays on Cloudflare Workers; reach it by public URL.
#    Leave AUTHZ_URL empty to disable the invite gate entirely. ──
AUTHZ_URL=
AUTHZ_SERVICE_SECRET=

# ── Optional Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
